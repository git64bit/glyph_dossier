function portable_representative_lock_matches(glyph_id) = [
    for (record = PORTABLE_REPRESENTATIVE_LOCK)
        if (record[PRL_ID] == glyph_id)
            record
];

function portable_representative_lock_by_id(glyph_id) =
    let(matches = portable_representative_lock_matches(glyph_id))
    assert(
        len(matches) == 1,
        str(
            "Expected one representative lock record for ",
            glyph_id,
            "; found ",
            len(matches)
        )
    )
    matches[0];
